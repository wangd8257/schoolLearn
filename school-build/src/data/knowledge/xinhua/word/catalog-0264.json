word":"族长","pinyin":"","meaning":"1.周代地方基层官名。 \n2.泛指一族之尊长。 \n3.周代地方基层单位\"族\"与\"长\"的并称。"},{"word":"族媋","pinyin":"","meaning":"1.见\"族姻\"。"},{"word":"族从","pinyin":"","meaning":"1.同族及从兄弟。"},{"word":"族党","pinyin":"","meaning":"1.亦作\"族?\"。 \n2.聚居的同族亲属。"},{"word":"族地","pinyin":"","meaning":"1.一姓一族的土地。"},{"word":"族弟","pinyin":"","meaning":"1.同高祖兄弟的弟辈。亦泛指同族同辈中年较少者。"},{"word":"族阀","pinyin":"","meaning":"1.犹家世。"},{"word":"族法","pinyin":"","meaning":"1.宗族或家族的法规。"},{"word":"族分","pinyin":"","meaning":"1.本族繁衍下来的人。"},{"word":"族父","pinyin":"","meaning":"1.同族兄弟之父。亦泛指同族伯叔父。"},{"word":"族父母","pinyin":"","meaning":"1.族父和族母。"},{"word":"族贯","pinyin":"","meaning":"1.家族籍贯。"},{"word":"族规","pinyin":"","meaning":"1.封建社会宗族或家族的法规。"},{"word":"族鬼","pinyin":"","meaning":"1.古时博戏的一种。"},{"word":"族徽","pinyin":"","meaning":"1.表示某个宗族或家族的标志。"},{"word":"族姬","pinyin":"","meaning":"1.宋政和间对县主的改称。"},{"word":"族家子","pinyin":"","meaning":"1.即族子。"},{"word":"族居","pinyin":"","meaning":"1.群居;聚居。 \n2.丛生。 \n3.犹言姓氏籍贯。"},{"word":"族举","pinyin":"","meaning":"1.并举。"},{"word":"族聚","pinyin":"","meaning":"1.同族的人聚在一起。"},{"word":"族昆弟","pinyin":"","meaning":"1.亦作\"族晜弟\"。 \n2.同高祖的兄弟。亦泛称同族同辈之人。"},{"word":"族晜弟","pinyin":"","meaning":"1.见\"族昆弟\"。"},{"word":"族絫","pinyin":"","meaning":"1.六畜疫病。"},{"word":"族类","pinyin":"","meaning":"1.指同族。 \n2.同类。 \n3.指同类的人。 \n4.种类。 \n5.指民族。"},{"word":"族蠡","pinyin":"","meaning":"1.见\"族絫\"。"},{"word":"族厉","pinyin":"","meaning":"1.称古大夫死而无后者。"},{"word":"族癳","pinyin":"","meaning":"1.亦作\"瘯癳\"。 \n2.皮肤病。"},{"word":"族落","pinyin":"","meaning":"1.聚族而居的村落。"},{"word":"族灭","pinyin":"","meaning":"1.谓一人犯罪﹐整个家族﹑亲属被诛灭。"},{"word":"族母","pinyin":"","meaning":"1.族兄弟之母。亦泛指同族伯叔之妻。参见\"族父母\"。"},{"word":"族年","pinyin":"","meaning":"也称赶年”。土家族的传统节日。在每年夏历七月初一。除夕夜，有的地区有守田埂”的习俗。次日要放爆竹接年”，再敬奉祖先，吃蒸坨子肉和合菜。节日期间，人们跳摆手舞、演出小戏《毛谷斯》等。"},{"word":"族女","pinyin":"","meaning":"1.同族兄弟之女。"},{"word":"族庖","pinyin":"","meaning":"1.众庖。指一般的厨师。"},{"word":"族谱","pinyin":"","meaning":"1.记载宗族或家族谱系的书册。"},{"word":"族戚","pinyin":"","meaning":"1.家族和亲戚。"},{"word":"族亲","pinyin":"","meaning":"1.家族和亲戚。 \n2.同族的亲戚。"},{"word":"族权","pinyin":"","meaning":"1.封建宗法制度下﹐族长对家族或家长对家庭成员的支配权力。"},{"word":"族人","pinyin":"","meaning":"1.同宗族的人;同家族的人。"},{"word":"族人炊","pinyin":"","meaning":"1.神名。"},{"word":"族杀","pinyin":"","meaning":"1.即族灭。"},{"word":"族绅","pinyin":"","meaning":"1.族里的绅士。"},{"word":"族生","pinyin":"","meaning":"1.丛生。"},{"word":"族师","pinyin":"","meaning":"1.周代官名。地官之属。百家之长。《周礼．地官》有\"族师\"﹐\"各掌其族之戒令政事。\"郑玄注引郑司农曰\"百家为族。\""},{"word":"族食","pinyin":"","meaning":"1.谓与族人宴饮。"},{"word":"族氏","pinyin":"","meaning":"1.宗族姓氏。"},{"word":"族世","pinyin":"","meaning":"1.犹世代。"},{"word":"族叔","pinyin":"","meaning":"1.族父中年少于父者。亦称同族中与父同辈而年少于父者。"},{"word":"族死","pinyin":"","meaning":"1.族灭。"},{"word":"族嗣","pinyin":"","meaning":"1.后嗣。宗族中的继承者。"},{"word":"族孙","pinyin":"","meaning":"1.同族兄弟的孙子。"},{"word":"族谈","pinyin":"","meaning":"1.聚语。"},{"word":"族田","pinyin":"","meaning":"1.宗族共有的田地。有祭田﹑社地﹑义庄田﹑祠堂田等名目。有的由族长经管﹐有的由族里委托专人经管。所收地租用于祭祀﹑助学﹑救济等。经管人常侵吞地租之一部或大部﹐侵吞全部以至祭祀不举者则较少见。"},{"word":"族望","pinyin":"","meaning":"1.有声望的名门大族。 \n2.在宗族中的声望。"},{"word":"族位","pinyin":"","meaning":"1.在宗族中的地位。"},{"word":"族味","pinyin":"","meaning":"1.鹌鹑的别名。"},{"word":"族系","pinyin":"","meaning":"1.家族的世系。"},{"word":"族夏","pinyin":"","meaning":"1.周代乐章名。为钟鼓乐九夏之一。"},{"word":"族姓","pinyin":"","meaning":"1.指同姓的亲族。 \n2.指家族姓氏。 \n3.指世族大姓。"},{"word":"族兄","pinyin":"","meaning":"1.同高祖兄弟的兄辈。亦泛指同族同辈中年较长者。"},{"word":"族兄弟","pinyin":"","meaning":"1.即族昆弟。"},{"word":"族盐","pinyin":"","meaning":"1.古代乐曲的一种。"},{"word":"族爷","pinyin":"","meaning":"1.一族中的长辈。"},{"word":"族夷","pinyin":"","meaning":"1.族灭。"},{"word":"族裔","pinyin":"","meaning":"1.宗族的后代。"},{"word":"族姻","pinyin":"","meaning":"1.亦作\"族媋\"。 \n2.家族和姻亲。"},{"word":"族胤","pinyin":"","meaning":"1.即族裔。"},{"word":"族嬴","pinyin":"","meaning":"1.宋徽宗时对县主的改称。"},{"word":"族约","pinyin":"","meaning":"1.旧称封建社会宗族或家族的规约。 \n2.族正之副。"},{"word":"族云","pinyin":"","meaning":"1.凝聚的云气。"},{"word":"族葬","pinyin":"","meaning":"1.同一高祖的子孙葬在一块墓地。"},{"word":"族曾王父","pinyin":"","meaning":"1.亦称\"族曾祖父\"。 \n2.父亲的从祖祖父。"},{"word":"族曾王母","pinyin":"","meaning":"1.亦称\"族曾祖母\"。 \n2.父亲的从祖祖母。"},{"word":"族曾祖父","pinyin":"","meaning":"1.见\"族曾王父\"。"},{"word":"族曾祖母","pinyin":"","meaning":"1.见\"族曾王母\"。"},{"word":"族帐","pinyin":"","meaning":"1.指我国古代北方和西北少数民族聚族而居的帐幕。 \n2.指我国古代北方和西北设帐聚族而居的部族。"},{"word":"族正","pinyin":"","meaning":"1.清时聚族而居的地方﹐挑选族中地位名望最高的人主持和裁决本族事务﹐名为\"族正\"。"},{"word":"族侄","pinyin":"","meaning":"1.同高祖从兄弟之子。唐高适有《宋中送族侄式颜》诗。唐韩愈有《赠徐州族侄》诗。"},{"word":"族诛","pinyin":"","meaning":"1.族灭。"},{"word":"族属","pinyin":"","meaning":"1.同族的亲属。"},{"word":"族子","pinyin":"","meaning":"1.同族兄弟之子。"},{"word":"族祖","pinyin":"","meaning":"1.即族祖父。"},{"word":"族祖父","pinyin":"","meaning":"1.族父的父亲。即自己祖父的堂兄弟。"},{"word":"族祖父母","pinyin":"","meaning":"1.族祖父与族祖母。"},{"word":"族祖母","pinyin":"","meaning":"1.族父的母亲。即自己祖父堂兄弟之妻。"},{"word":"族罪","pinyin":"","meaning":"1.谓罪及父﹑母﹑妻三族。"},{"word":"族尊","pinyin":"","meaning":"1.宗族中地位或辈分高的人。"},{"word":"踤衡","pinyin":"","meaning":"1.谓栖立于辕前横木上。"},{"word":"踤阹","pinyin":"","meaning":"1.聚合成围阵。"},{"word":"踤蓄","pinyin":"","meaning":"1.积贮备用。"},{"word":"踤跖","pinyin":"","meaning":"1.停步踏足。喻笛声乍起于地。"},{"word":"踤","pinyin":"","meaning":"1.见\"踤?\"。"},{"word":"踿跄","pinyin":"","meaning":"1.紧随着舞动的样子。"},{"word":"镞砺","pinyin":"","meaning":"1.磨砺箭头。比喻刻苦磨练﹐力求精进。"},{"word":"作弊","pinyin":"","meaning":"1.用欺骗的手法去做违背制度或规定的事情。"},{"word":"作壁上观","pinyin":"","meaning":"《史记·项羽本纪》及楚击秦，诸将皆从壁上观。”双方交战，第三方在壁垒上旁观。比喻在局外旁观，不表示态度。"},{"word":"作别","pinyin":"","meaning":"分手；告别起身作别｜作别而去。"},{"word":"作蹩子","pinyin":"","meaning":"1.见\"作瘪子\"。"},{"word":"作瘪子","pinyin":"","meaning":"1.方言。为难;难堪。也写作\"作蹩子\"。"},{"word":"作宾","pinyin":"","meaning":"1.指担任太子宾客职务。"},{"word":"作冰","pinyin":"","meaning":"1.旧称做媒人。"},{"word":"作兵","pinyin":"","meaning":"1.指担任维修任务的士兵。"},{"word":"作病","pinyin":"","meaning":"1.发生疾病，致病。"},{"word":"作不准","pinyin":"","meaning":"1.方言。谓难以断定。"},{"word":"作部","pinyin":"","meaning":"1.古时制作兵器的部门。"},{"word":"作册","pinyin":"","meaning":"1.古官名。商代设置。西周时也称作册内史﹑作命内史﹑内史。掌著作简册，奉行国王告命。"},{"word":"作册内史","pinyin":"","meaning":"1.古代官名。"},{"word":"作册尹","pinyin":"","meaning":"1.古代官名。作册之长。"},{"word":"作茶","pinyin":"","meaning":"1.制茶。"},{"word":"作伥","pinyin":"","meaning":"1.助纣为虐，为坏人做事。"},{"word":"作场","pinyin":"","meaning":"1.民间艺人在空地上表演献艺。"},{"word":"作倡","pinyin":"","meaning":"1.演奏音乐或表演歌舞。"},{"word":"作成","pinyin":"","meaning":"1.成全;照顾。 \n2.培育;造就。 \n3.装作。 \n4.作为;当成。"},{"word":"作程","pinyin":"","meaning":"1.作楷模﹑典范。 \n2.立法度，做准则。"},{"word":"作辍无常","pinyin":"","meaning":"1.汉扬雄《法言．孝至》\"或曰'何以处伪?'曰'有人则作﹑无人则辍之谓伪。观人者，审其作辍而已矣。'\"后因称时作时歇﹑不能持久为\"作辍无常\"。"},{"word":"作辞","pinyin":"","meaning":"1.谓称美其言辞。 \n2.告辞，告别。"},{"word":"作达","pinyin":"","meaning":"1.谓仿效放达行为。 \n2.指放达。"},{"word":"作答","pinyin":"","meaning":"1.做出回答。 \n2.指复信。"},{"word":"作大","pinyin":"","meaning":"1.摆架子。"},{"word":"作歹为非","pinyin":"","meaning":"1.做各种坏事。"},{"word":"作刀","pinyin":"","meaning":"1.工匠使用的刀具。"},{"word":"作纛旗儿","pinyin":"","meaning":"1.犹言主事者，当家人。纛旗，军中主帅之旗。"},{"word":"作得","pinyin":"","meaning":"1.犹言能做。"},{"word":"作底","pinyin":"","meaning":"1.亦作\"作抵\"。 \n2.如何，怎样。 \n3.为何，为什么。"},{"word":"作抵","pinyin":"","meaning":"1.见\"作底\"。"},{"word":"作刁","pinyin":"","meaning":"1.有意为难。"},{"word":"作东","pinyin":"","meaning":"1.作东道主。语出《左传．僖公三十年》\"若舍郑以为东道主，行李之往来，共其乏困，君亦无所害。\"后泛称请客。"},{"word":"作动","pinyin":"","meaning":"1.举止动作。 \n2.指孕妇产前发生的胎动。"},{"word":"作队","pinyin":"","meaning":"1.结伴成列。"},{"word":"作对","pinyin":"","meaning":"1.做配偶。 \n2.做对头，为敌。 \n3.做对联，对对子。"},{"word":"作对头","pinyin":"","meaning":"1.与人为敌﹑为难。"},{"word":"作厄","pinyin":"","meaning":"1.作难，作梗。多用以指天气阴雨。"},{"word":"作咢","pinyin":"","meaning":"1.作噩。"},{"word":"作恶","pinyin":"","meaning":"1.谓以私意憎恶人﹑罚人。"},{"word":"作恶多端","pinyin":"","meaning":"1.谓做坏事极多。"},{"word":"作鄂","pinyin":"","meaning":"1.作噩。"},{"word":"作詻","pinyin":"","meaning":"1.即作噩。"},{"word":"作噩","pinyin":"","meaning":"1.十二支中\"酉\"的别称，用以纪年。"},{"word":"作伐","pinyin":"","meaning":"《诗·豳风·伐柯》伐柯如何，匪斧不克；取妻如何，匪媒不得。”后因称作伐”为作媒为人作伐，成其婚配。"},{"word":"作筏子","pinyin":"","meaning":"1.做样子。比喻找差错予以惩治，以警其馀。"},{"word":"作法","pinyin":"","meaning":"1.谓创制法律﹑典章等。 \n2.施展法术。 \n3.指弄手段。 \n4.做样子。谓惩治以警其余。 \n5.作文或作画的方法。 6.做法。 7.指行为表现的方式。"},{"word":"作法自毙","pinyin":"","meaning":"语出《史记·商君列传》商鞅受诬逃亡，欲住客舍，店主说，商君之法，舍人无验者坐之”，商君叹道嗟乎!为法之敝，一至此哉!”后以作法自毙”称自己出的主意反而使自己受害。"},{"word":"作法自弊","pinyin":"","meaning":"1.谓自己立法反而使自己受害。语出《史记．商君列传》\"﹝秦惠王﹞发吏捕商君。商君亡至关下，欲舍客舍。客人不知其是商君也，曰'商君之法，舍人无验者坐之。'商君喟然叹曰'嗟乎!为法之敝，一至此哉!'\""},{"word":"作烦","pinyin":"","meaning":"1.制造麻烦，添麻烦。"},{"word":"作反","pinyin":"","meaning":"1.犹言造反。"},{"word":"作范","pinyin":"","meaning":"1.树立榜样。"},{"word":"作梵","pinyin":"","meaning":"1.诵经。梵，指佛经。"},{"word":"作坊","pinyin":"","meaning":"1.从事手工制造加工的工场。也称\"作场\"﹑\"坊\"﹑\"房\"﹑\"作\"等。古代有官府作坊及民间作坊之分。"},{"word":"作坊(ｚｕō-)","pinyin":"","meaning":"从事手工业生产的场所。工具一般比较简陋。个体手工业者作坊由作坊主(一般是有较高技艺的师傅)带领帮工或学徒在生产中实行简单协作。历史上有奴隶主、封建主或官府办的大作坊，生产中实行以分工为基础的协作。"},{"word":"作房","pinyin":"","meaning":"1.手工业工场，作坊。"},{"word":"作废","pinyin":"","meaning":"1.因失效而废弃;弃置不用。"},{"word":"作风","pinyin":"","meaning":"人们在工作、学习和生活中表现出来的稳定的态度和行为。包括思想作风、工作作风、生活作风等。它的形成主要取决于个人的自觉培养和一定的组织纪律约束。良好的作风有认真仔细、严谨踏实、任劳任怨、一丝不苟等。"},{"word":"作夫","pinyin":"","meaning":"1.耕作之夫，农民。"},{"word":"作孚","pinyin":"","meaning":"1.信服﹑信从。 \n2.谓示以诚信。"},{"word":"作福","pinyin":"","meaning":"1.谓作善事而获福祉。 \n2.赐福。"},{"word":"作覆","pinyin":"","meaning":"1.答复。通常指给回信。"},{"word":"作甘","pinyin":"","meaning":"1.谓作救旱甘霖。《书．说命上》\"若岁大旱﹐用汝作霖雨。\"孔传\"霖﹐三日雨。霖以救旱。\"后因以\"作甘\"为救旱之称。"},{"word":"作歌","pinyin":"","meaning":"1.谓作歌词而咏唱。"},{"word":"作梗","pinyin":"","meaning":"1.谓鬼物使人生病。 \n2.指从中阻挠﹑捣乱。"},{"word":"作工","pinyin":"","meaning":"1.劳动;做工。"},{"word":"作工徒","pinyin":"","meaning":"1.指服劳役的工匠。"},{"word":"作古","pinyin":"","meaning":"已作古人。死的婉词作古之人｜早已作古。"},{"word":"作古正经","pinyin":"","meaning":"1.犹言一本正经。"},{"word":"作谷","pinyin":"","meaning":"1.指田里生长着的谷物。"},{"word":"作羖","pinyin":"","meaning":"1.围棋术语。谓在一片棋中\"做眼\"以求活局的棋术。"},{"word":"作故","pinyin":"","meaning":"故成例。不依旧例，自创先规伤负心期，自谁作故。"},{"word":"作怪","pinyin":"","meaning":"1.谓鬼神等与人为难。 \n2.指捣鬼，起坏作用。 \n3.泛指发生影响，起作用。 \n4.犹离奇古怪。 \n5.发生性行为的讳称。"},{"word":"作馆","pinyin":"","meaning":"1.指受聘至人家坐馆授徒。"},{"word":"作轨","pinyin":"","meaning":"1.作为规范。"},{"word":"作过","pinyin":"","meaning":"1.做坏事。 \n2.特指叛乱﹑闹事等。"},{"word":"作害","pinyin":"","meaning":"1.为害。"},{"word":"作翰","pinyin":"","meaning":"1.谓为柱石重臣〔，桢干。"},{"word":"作好","pinyin":"","meaning":"1.谓徇私偏好。"},{"word":"作好作歹","pinyin":"","meaning":"1.谓装出和气﹑严厉各种面目，来解决纷争。"},{"word":"作耗","pinyin":"","meaning":"1.作乱;叛乱。 \n2.指妖物作怪。 \n3.任性胡为。"},{"word":"作合","pinyin":"","meaning":"1.《诗．大雅．大明》\"文王初载，天作之合。\"后因以\"作合\"指男女结成夫妇。 \n2.引申指做媒。"},{"word":"作横","pinyin":"","meaning":"1.指横行不法。"},{"word":"作花","pinyin":"","meaning":"1.长出花蕾;开花。"},{"word":"作画","pinyin":"","meaning":"1.绘画。"},{"word":"作荒","pinyin":"","meaning":"1.旧谓荒年将至，百姓饭量增大的现象。"},{"word":"作会","pinyin":"","meaning":"1.举行会盟。 \n2.指各种聚会。"},{"word":"作诲","pinyin":"","meaning":"1.教诲;训导。"},{"word":"作诨","pinyin":"","meaning":"1.打诨。开玩笑。"},{"word":"作活","pinyin":"","meaning":"1.为生;过日子。 \n2.干活。"},{"word":"作火","pinyin":"","meaning":"1.用火;燃火。"},{"word":"作稽","pinyin":"","meaning":"1.指言行举止。作，行;稽，止。"},{"word":"作急","pinyin":"","meaning":"1.从速;尽快。"},{"word":"作计","pinyin":"","meaning":"1.谋划;考虑。 \n2.谓出主意，设法。"},{"word":"作伎","pinyin":"","meaning":"1.亦作\"作妓\"。 \n2.谓表演歌舞或演奏音乐。"},{"word":"作妓","pinyin":"","meaning":"1.见\"作伎\"。"},{"word":"作家","pinyin":"","meaning":"1.治家，理家。 \n2.节俭。犹言做人家。 \n3.从事文学创作有成就的人。 \n4.佛教禅宗对善用机锋者之称。 \n5.行家;高手。"},{"word":"作家歌","pinyin":"","meaning":"1.行家所作的乐府诗歌。"},{"word":"作家气","pinyin":"","meaning":"1.指模拟工巧而缺乏创造的匠人气息。"},{"word":"作价","pinyin":"","meaning":"1.估核价格。"},{"word":"作假","pinyin":"","meaning":"1.指言行举止不真诚，不真实。 \n2.制造假的，冒充真的;真的里头搀假的;好的里头搀坏的。"},{"word":"作嫁","pinyin":"","meaning":"1.谓为别人操劳忙碌。"},{"word":"作嫁衣裳","pinyin":"","meaning":"1.谓白白替别人操劳，自己却无所得。语本唐秦韬玉《贫女》诗\"苦恨年年压金线，为他人作嫁衣裳。\""},{"word":"作奸","pinyin":"","meaning":"1.见\"作奸\"。"},{"word":"作奸犯科","pinyin":"","meaning":"为非作歹，违犯法纪作奸犯科者，一律严惩。"},{"word":"作奸犯罪","pinyin":"","meaning":"1.作奸犯科。"},{"word":"作茧","pinyin":"","meaning":"1.蚕老结茧。 \n2.比喻出仕。 \n3.比喻妇女怀孕生育。"},{"word":"作茧自缚","pinyin":"","meaning":"蚕老后吐丝结茧，将自己包在其中。喻人做事自陷困境自以为是的行动，导致了他作茧自缚。"},{"word":"作见","pinyin":"","meaning":"1.显现;出现。"},{"word":"作件","pinyin":"","meaning":"1.作为机械加工对象的零件。多指在机械加工过程中的零件。也叫工件或制件。"},{"word":"作健","pinyin":"","meaning":"1.成为强者。谓奋发称雄。"},{"word":"作践","pinyin":"","meaning":"摧残；糟踏作践人｜作践狼藉｜被人作践。"},{"word":"作娇","pinyin":"","meaning":"1.谓两情欢爱。"},{"word":"作娇作痴","pinyin":"","meaning":"1.形容故作娇态。"},{"word":"作脚","pinyin":"","meaning":"1.谓从中牵线联络。"},{"word":"作解","pinyin":"","meaning":"1.谓解救百姓。"},{"word":"作紧","pinyin":"","meaning":"1.从速，火急。"},{"word":"作劲","pinyin":"","meaning":"1.用力;使劲。"},{"word":"作景","pinyin":"","meaning":"1.作梗，为难。 \n2.作耍，开玩笑。"},{"word":"作具","pinyin":"","meaning":"1.工具;器械。 \n2.指刑具。"},{"word":"作剧","pinyin":"","meaning":"1.劳作勤苦。 \n2.戏弄，开玩笑。 \n3.表演戏术。"},{"word":"作郡","pinyin":"","meaning":"1.指担任一郡长官，治理地方。"},{"word":"作科","pinyin":"","meaning":"1.制定法规。"},{"word":"作客","pinyin":"","meaning":"1.谓寄居异地。 \n2.作客商。 \n3.去别人处做客人。"},{"word":"作苦","pinyin":"","meaning":"1.耕作辛苦。 \n2.感到痛苦。谓难受。"},{"word":"作朗","pinyin":"","meaning":"1.犹言怎么办。"},{"word":"作浪兴风","pinyin":"","meaning":"1.掀起风浪。比喻制造事端。"},{"word":"作浪语","pinyin":"","meaning":"1.不负责任﹑随便乱说。"},{"word":"作劳","pinyin":"","meaning":"1.劳作，劳动。"},{"word":"作乐","pinyin":"","meaning":"1.制作音乐。 \n2.奏乐。"},{"word":"作垒","pinyin":"","meaning":"1.作梗，阻挠。"},{"word":"作礼","pinyin":"","meaning":"1.举手施礼;行礼。"},{"word":"作力","pinyin":"","meaning":"1.出力;使力。"},{"word":"作吏","pinyin":"","meaning":"1.谓担任官职。"},{"word":"作戾","pinyin":"","meaning":"1.制造暴乱，作乱。"},{"word":"作俪","pinyin":"","meaning":"1.作配偶，成婚。"},{"word":"作敛","pinyin":"","meaning":"1.谓聚敛民财。"},{"word":"作脸","pinyin":"","meaning":"1.争脸面，争出风头。"},{"word":"作两","pinyin":"","meaning":"1.《易．离》\"明两作离，大人以继明照于四方。\"孔颖达疏\"明两作离者，离为日，日为明，今有上下两体，故云明两作离也。\"后本《易》\"继明\"之意，称太子为\"作两\"。言能继天子而明照四方。"},{"word":"作料","pinyin":"","meaning":"1.匠人所用的材料。 \n2.泛指材料。"},{"word":"作乱","pinyin":"","meaning":"暴乱；发动叛乱制止作乱｜盗匪作乱。"},{"word":"作洛","pinyin":"","meaning":"1.语出《书．多士》\"今朕作大邑于兹洛。\"周都于镐京，周成王时，周公又建洛邑为东都◇世因以\"作洛\"指另建新都。"},{"word":"作马","pinyin":"","meaning":"1.木工使用的一种简便支架。"},{"word":"作眉","pinyin":"","meaning":"1.指描画眉毛。"},{"word":"作梅","pinyin":"","meaning":"1.拣选杨梅。"},{"word":"作美","pinyin":"","meaning":"成全好事天公不作美。"},{"word":"作面子","pinyin":"","meaning":"1.装点脸面。"},{"word":"作民","pinyin":"","meaning":"1.役使民众。"},{"word":"作牧","pinyin":"","meaning":"1.畜牧，放牧。 \n2.周代，侯伯有功德者，加命为州长，得专征伐于诸侯，谓\"作牧\"。 \n3.泛指担任州郡地方长官。"},{"word":"作难","pinyin":"","meaning":"①(-ｎàｎ)叛乱；作乱一夫作难而七庙堕。②为难；受窘从中作难｜万分作难。"},{"word":"作闹","pinyin":"","meaning":"1.起哄闹事。"},{"word":"作逆","pinyin":"","meaning":"1.作乱，造反。"},{"word":"作念","pinyin":"","meaning":"1.思念;怀念。"},{"word":"作孽","pinyin":"","meaning":"1.制造灾难。 \n2.引申指作乱，作恶。 \n3.谓遭罪受苦。"},{"word":"作弄","pinyin":"","meaning":"耍弄；戏弄别作弄人｜受人作弄。"},{"word":"作诺","pinyin":"","meaning":"1.连声答应。表示顺从。"},{"word":"作呕","pinyin":"","meaning":"1.谓恶心欲吐。 \n2.比喻非常厌恶。"},{"word":"作排","pinyin":"","meaning":"1.谓安排宴席。"},{"word":"作派","pinyin":"","meaning":"1.派头;故作的姿态架势。 \n2.指作风。"},{"word":"作陪","pinyin":"","meaning":"1.当陪客。"}]
